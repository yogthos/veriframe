{:material "5758:{:paths [\"src\" \"vendor\" \"resources\"]\n\n ;; Git deps are fetched into ~/.jolt/gitlibs by jolt. Full SHAs only —\n ;; `git fetch` can't resolve short ones.\n :deps {;; provider calls (clj-http-lite over jolt.ffi sockets + OpenSSL + libz)\n        ;; v0.0.3 honours :conn-timeout: it bounds the connect itself through a\n        ;; non-blocking socket, which needs jolt 0.6.8's :varargs FFI marker\n        ;; (fcntl is variadic, and on Apple arm64 a fixed-arity binding\n        ;; silently corrupts the stack-passed argument).\n        jolt-lang/http-client\n        {:git/url \"https://github.com/jolt-lang/http-client\"\n         :git/tag \"v0.0.3\"\n         :git/sha \"add8184b819b69dcfed1305b9577eb8794f76409\"}\n\n        ;; durable sessions: jdbc.core over the system libsqlite3 via jolt.ffi\n        jolt-lang/db\n        {:git/url \"https://github.com/jolt-lang/db\"\n         :git/sha \"c3ed5b333b5feed615d49c118493a00edc537739\"}\n\n        ;; nREPL middleware (sessions, interruptible eval, completion, lookup) so\n        ;; an editor can drive the running harness. See core/start-nrepl!.\n        jolt-lang/nrepl\n        {:git/url \"https://github.com/jolt-lang/nrepl\"\n         :git/sha \"10bf63fd19f66b39587f4a5756d0644231b2d4c1\"}\n\n        ;; OpenSSL/SecureRandom shims. http-client pulls this in too; jolt.deps\n        ;; reconciles the duplicate libssl/libcrypto natives to a single load.\n        jolt-lang/jolt-crypto\n        {:git/url \"https://github.com/jolt-lang/jolt-crypto\"\n         :git/sha \"1ab72aa5f73be7ec41f01086953ffb43ecd3d84e\"}\n\n        org.clojure/data.json\n        {:git/url \"https://github.com/clojure/data.json\"\n         :git/sha \"94463ffb54482427fd9b31f264b06bff6dcfd557\"}\n\n        ;; clojure.tools.logging ported to jolt (stderr backend, :info+ default)\n        org.clojure/tools.logging\n        {:git/url \"https://github.com/jolt-lang/logging\"\n         :git/sha \"ec6747e55583118d881faf4ab41e68d7e587ce4c\"}\n\n        ;; java.time host shim. tools.logging formats timestamps with\n        ;; DateTimeFormatter, which core does not provide (RFC 0008), so\n        ;; logging anything without this dep throws at the first log call.\n        jolt-lang/time\n        {:git/url \"https://github.com/jolt-lang/time\"\n         :git/sha \"da271ca302487c2c5130a0450b4ad4c78d63e656\"}}\n\n ;; The vendored HTTP server (vendor/ring_chez/adapter.clj) binds BSD sockets\n ;; through the running process's own libc symbols, so they must be loaded\n ;; before that namespace is required.\n :jolt/native [{:name \"libc (POSIX sockets)\" :process true}]\n\n :nrepl/middleware [nrepl.middleware/default-middleware]\n\n :aliases {:test {:extra-paths [\"test\" \"gui\"]\n                  :main-opts [\"-m\" \"veriframe.test-runner\"]}\n           ;; command-line nREPL client, plus the test tree, so the live\n           ;; process can run the suite over nREPL without paying startup:\n           ;;   (require 'veriframe.test-runner :reload-all)\n           ;;   (veriframe.test-runner/run)\n           :dev  {:extra-paths [\"dev\" \"test\"]}\n\n           ;; The GUI is an optional component and a strict HTTP client of the\n           ;; server: its source root and its GTK/GL deps live ONLY under this\n           ;; alias, so `jolt serve` and `jolt -M:test` stay headless and never\n           ;; load a native toolkit.\n           :gui  {:extra-paths [\"gui\"]\n                  :extra-deps\n                  {;; glimmer is now the portable reactive core only — ratom,\n                   ;; the component model and the reconciler — and knows about\n                   ;; no toolkit. v0.1.0 is the release that split GTK out.\n                   ;; It still carries the two fixes this GUI needs: the swap!\n                   ;; nil-argument fix, and :scroll-top on :scrolled, without\n                   ;; which the inspector opens part-way down the previous\n                   ;; selection.\n                   jolt-lang/glimmer\n                   {:git/url \"https://github.com/jolt-lang/glimmer.git\"\n                    :git/tag \"v0.1.0\"\n                    :git/sha \"5581c331c51aff989259b9e8e92ec920fe5e6741\"}\n                   ;; The GTK4 backend: the widgets, the prop/signal wiring and\n                   ;; the app loop, registered through glimmer.backend. It also\n                   ;; owns the GTK/GLib :jolt/native declarations, which is why\n                   ;; none appear here. `glimmer.ffi` and `glimmer.widget` live\n                   ;; here now as `glimmer-gtk.ffi` and `glimmer-gtk.widget`.\n                   jolt-lang/glimmer-gtk\n                   {:git/url \"https://github.com/jolt-lang/glimmer-gtk.git\"\n                    :git/tag \"v0.1.0\"\n                    :git/sha \"ce79d45698d36ccf496397bb85974e3cce6abfd8\"}\n                   ;; Pinned past the split too: glimmer-gl.gtk registers\n                   ;; :gl-area and :scale into the widget registry, which now\n                   ;; lives in glimmer-gtk, so an older glimmer-gl fails to\n                   ;; load with `Could not locate glimmer/ffi`.\n                   jolt-lang/glimmer-gl\n                   {:git/url \"https://github.com/jolt-lang/glimmer-gl.git\"\n                    :git/tag \"v0.1.0\"\n                    :git/sha \"ae9a53291c553e89dde79a90389224f46e5e7fa8\"}}\n                  :main-opts [\"-m\" \"veriframe.gui.core\"]}}\n\n :tasks {serve {:doc \"start the harness (HTTP + nREPL) and park\"\n                :main-opts [\"-m\" \"veriframe.core\"]}\n         ;; A shell-string task, because a :tasks :main-opts entry cannot carry\n         ;; an -A alias — main-opts are only ever main-opts.\n         dev   \"jolt -A:dev -m veriframe.core\"\n         smoke {:doc \"Phase 0 platform probes: z3, swipl, sqlite, https, server\"\n                :main-opts [\"-m\" \"veriframe.smoke\"]}\n         test  \"jolt -M:test\"\n         gui   \"jolt -M:gui\"}}\n|679:{:aliases {;; Add cross-project aliases here\n           :outdated {;; Note that it is `:deps`, not `:extra-deps`\n                      :deps {com.github.liquidz/antq {:mvn/version \"2.5.1109\"}}\n                      :main-opts [\"-m\" \"antq.core\"]}\n           :mcp\n           {:deps {org.slf4j/slf4j-nop {:mvn/version \"2.0.16\"} ;; Required for stdio server\n                   com.bhauman/clojure-mcp {:git/url \"https://github.com/bhauman/clojure-mcp.git\"\n                                            :git/tag \"v0.1.6-alpha\"\n                                            :git/sha \"4ad62f4\"}}\n            :exec-fn clojure-mcp.main/start-mcp-server\n            :exec-args {:port 7888}}}}\n|[:gui]|v0.7.11|/Users/yogthos/.jolt/gitlibs|||||/Users/yogthos|", :value {:roots ["/Users/yogthos/.gitlibs/libs/org.clojure/data.json/94463ffb54482427fd9b31f264b06bff6dcfd557/src/main/clojure" "/Users/yogthos/.gitlibs/libs/jolt-lang/db/c3ed5b333b5feed615d49c118493a00edc537739/clj" "/Users/yogthos/.jolt/gitlibs/https___github.com_jolt-lang_logging/ec6747e55583118d881faf4ab41e68d7e587ce4c/src" "/Users/yogthos/.jolt/gitlibs/https___github.com_jolt-lang_glimmer.git/5581c331c51aff989259b9e8e92ec920fe5e6741/src" "/Users/yogthos/.gitlibs/libs/jolt-lang/nrepl/10bf63fd19f66b39587f4a5756d0644231b2d4c1/src" "/Users/yogthos/.jolt/gitlibs/https___github.com_jolt-lang_jolt-crypto/1ab72aa5f73be7ec41f01086953ffb43ecd3d84e/src" "/Users/yogthos/.jolt/gitlibs/https___github.com_jolt-lang_glimmer-gl.git/ae9a53291c553e89dde79a90389224f46e5e7fa8/src" "/Users/yogthos/.jolt/gitlibs/https___github.com_jolt-lang_glimmer-gtk.git/ce79d45698d36ccf496397bb85974e3cce6abfd8/src" "/Users/yogthos/.gitlibs/libs/jolt-lang/time/da271ca302487c2c5130a0450b4ad4c78d63e656/src" "/Users/yogthos/.gitlibs/libs/jolt-lang/time/da271ca302487c2c5130a0450b4ad4c78d63e656/vendor/time-literals" "/Users/yogthos/.jolt/gitlibs/https___github.com_jolt-lang_http-client/6faba3570378df91c2c84a588a262b732f4f1858/src" "/Users/yogthos/.m2/repository/org/clo